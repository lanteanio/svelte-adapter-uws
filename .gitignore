node_modules
# Anchored to the repository root. Unanchored, `build` matches a directory of
# that name at ANY depth, so a hand-written module under one is invisible to
# git while npm still packs it from the `files` allowlist - the published
# tarball works and a fresh clone does not, which is the pairing that hides.
# Source belongs at src/ root beside build-config.js, never under a build/.
/build
coverage
bench/_tmp_static
.env
.env.*
.DS_Store
*.log
source
# Kit's generated output, wherever a fixture app lives. This was two
# path-specific entries, which is why a third fixture app committed 84 build
# artifacts: the rule has to be about the directory, not about the two places
# that happened to exist when it was written.
.svelte-kit
test/fixture/node_modules
test/fixture/build
test/fixture/build-*
# The plural directory is a different tree with the same generated output.
test/fixtures/*/build
test/fixture/.build-lock
test-results
playwright-report
